{
  "name": "verified-sudoku-coach",
  "version": "0.0.0",
  "private": true,
  "description": "Verified AI coaching architecture and evaluation for Sudoku",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/memorex386/verified-sudoku-coach.git"
  },
  "type": "module",
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "ci:check": "node scripts/verify-ci.mjs",
    "lint": "eslint . --max-warnings 0",
    "docs:check": "node scripts/verify-docs.mjs",
    "architecture:check": "node scripts/verify-architecture.mjs",
    "work-packages:generate": "node scripts/generate-work-package-registry.mjs",
    "work-packages:check": "node scripts/generate-work-package-registry.mjs --check",
    "runtime-ai:check": "node scripts/verify-runtime-ai.mjs",
    "eval:replay": "node scripts/eval-replay.mjs",
    "security:check": "node scripts/verify-public-boundary.mjs",
    "licenses:check": "node scripts/verify-licenses.mjs",
    "skills:check": "node scripts/verify-skills.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test scripts/validation.test.mjs",
    "verify": "npm run doctor && npm run ci:check && npm run lint && npm run docs:check && npm run architecture:check && npm run work-packages:check && npm run runtime-ai:check && npm run eval:replay && npm run security:check && npm run licenses:check && npm run skills:check && npm test && npm run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "typescript-eslint": "8.69.0",
    "typescript": "7.0.2"
  }
}
