{
  "schemaVersion": 1,
  "policyVersion": "VSC-AUTOMATION-1",
  "policySha256": "ffb998786bd30f2a5eb0faa8e8a648dd4fe4be111939bb03ebec72acf6aca644",
  "mode": "shadow",
  "source": {
    "kind": "dependabot",
    "ecosystem": "npm",
    "actor": "dependabot[bot]",
    "event": "pull_request",
    "classification": "deterministic-diff"
  },
  "eligibility": {
    "dependencySection": "devDependencies",
    "directDependency": "required",
    "existingDependency": "required",
    "updateType": "semver-patch",
    "allowedFiles": ["package.json", "package-lock.json"],
    "forbiddenRiskCodes": [
      "compiler-or-build-tool",
      "license-change",
      "lifecycle-script",
      "missing-telemetry",
      "native-dependency",
      "new-direct-package",
      "peer-conflict",
      "security-sensitive-surface",
      "source-change",
      "vulnerability-increase",
      "workflow-change"
    ],
    "statefulChanges": "ineligible",
    "irreversibleChanges": "ineligible",
    "ineligibleOutcome": "deferred"
  },
  "identity": {
    "headSha": "required-full-lowercase-sha1",
    "failureFingerprint": "required-lowercase-sha256",
    "idempotencyKeyTemplate": "dependabot:{repository}:pr-{pullRequestNumber}:{headSha}:{failureFingerprint}:{policyVersion}"
  },
  "modelRoute": {
    "selectionAuthority": "deterministic-controller",
    "cheapProfileClass": "low-cost-diagnosis",
    "strongProfileClass": "complex-diagnosis",
    "selfSelection": "forbidden",
    "inputData": "sanitized-evidence",
    "outputMode": "strict-proposal"
  },
  "decisionOrder": [
    "deterministic-classification",
    "cheap-model-assessment",
    "strong-model-escalation",
    "repair",
    "patch-publication-grant",
    "ci-flake-rerun",
    "merge-grant",
    "release-promotion-grant",
    "deploy-grant",
    "rollback-grant",
    "terminal-outcome"
  ],
  "attemptCaps": {
    "cheapAssessments": 1,
    "strongEscalations": 1,
    "repairAttempts": 1,
    "patchPublications": 1,
    "ciFlakeReruns": 1,
    "mergeAttempts": 1,
    "releasePromotions": 1,
    "deployAttempts": 1,
    "rollbackAttempts": 1
  },
  "authority": {
    "patchPublication": {
      "grantId": "dependency-patch-publish",
      "credentialClass": "source-control-patch",
      "required": true,
      "automatic": false,
      "humanGatedPhase": "evidence"
    },
    "pullRequestMerge": {
      "grantId": "dependency-pr-merge",
      "credentialClass": "source-control-merge",
      "required": true,
      "automatic": false,
      "humanGatedPhase": "evidence"
    },
    "releasePromotion": {
      "grantId": "release-promotion",
      "credentialClass": "release-artifact",
      "required": true,
      "automatic": false,
      "humanGatedPhase": "evidence"
    },
    "productionDeploy": {
      "grantId": "production-deploy",
      "credentialClass": "production-deploy",
      "required": true,
      "automatic": false,
      "humanGatedPhase": "evidence"
    },
    "productionRollback": {
      "grantId": "production-rollback",
      "credentialClass": "production-rollback",
      "required": true,
      "automatic": false,
      "humanGatedPhase": "evidence"
    }
  },
  "terminalOutcomes": [
    "verified",
    "completed",
    "deferred",
    "stale",
    "awaiting-approval",
    "escalated",
    "failed-terminal",
    "reverted"
  ]
}
