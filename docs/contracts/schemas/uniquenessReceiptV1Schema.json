{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaId": {
      "type": "string",
      "const": "vsc.uniqueness-receipt"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "puzzleFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "solverVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "solutionCount": {
      "type": "number",
      "const": 1
    }
  },
  "required": [
    "schemaId",
    "version",
    "puzzleFingerprint",
    "solverVersion",
    "solutionCount"
  ],
  "additionalProperties": false
}
