{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaId": {
      "type": "string",
      "const": "vsc.proof-step"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "proofId": {
      "type": "string",
      "pattern": "^proof_[0-9a-f]{64}(?![\\s\\S])"
    },
    "puzzleId": {
      "type": "string",
      "pattern": "^puz_[a-z0-9]{16,64}(?![\\s\\S])"
    },
    "puzzleFingerprint": {
      "$ref": "#/$defs/__schema0"
    },
    "sourceBoardRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sourceBoardFingerprint": {
      "$ref": "#/$defs/__schema0"
    },
    "rulesetVersion": {
      "type": "string",
      "const": "classic-six/v1"
    },
    "technique": {
      "type": "string",
      "enum": [
        "naked-single",
        "hidden-single",
        "locked-pointing",
        "locked-claiming",
        "naked-pair",
        "hidden-pair"
      ]
    },
    "beforeStateFingerprint": {
      "$ref": "#/$defs/__schema0"
    },
    "afterStateFingerprint": {
      "$ref": "#/$defs/__schema0"
    },
    "premises": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "technique": {
              "type": "string",
              "const": "naked-single"
            },
            "targetCellId": {
              "$ref": "#/$defs/__schema1"
            },
            "candidateDigits": {
              "minItems": 1,
              "maxItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema2"
              }
            }
          },
          "required": [
            "technique",
            "targetCellId",
            "candidateDigits"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "technique": {
              "type": "string",
              "const": "hidden-single"
            },
            "unit": {
              "$ref": "#/$defs/__schema3"
            },
            "digit": {
              "$ref": "#/$defs/__schema2"
            },
            "candidateCellIds": {
              "minItems": 1,
              "maxItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema1"
              }
            }
          },
          "required": [
            "technique",
            "unit",
            "digit",
            "candidateCellIds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "technique": {
              "type": "string",
              "const": "locked-pointing"
            },
            "sourceBox": {
              "$ref": "#/$defs/__schema7"
            },
            "digit": {
              "$ref": "#/$defs/__schema2"
            },
            "candidateCellIds": {
              "minItems": 2,
              "maxItems": 3,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema1"
              }
            },
            "confinedTo": {
              "$ref": "#/$defs/__schema8"
            }
          },
          "required": [
            "technique",
            "sourceBox",
            "digit",
            "candidateCellIds",
            "confinedTo"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "technique": {
              "type": "string",
              "const": "locked-claiming"
            },
            "sourceLine": {
              "$ref": "#/$defs/__schema8"
            },
            "digit": {
              "$ref": "#/$defs/__schema2"
            },
            "candidateCellIds": {
              "minItems": 2,
              "maxItems": 3,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema1"
              }
            },
            "confinedToBox": {
              "$ref": "#/$defs/__schema7"
            }
          },
          "required": [
            "technique",
            "sourceLine",
            "digit",
            "candidateCellIds",
            "confinedToBox"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "technique": {
              "type": "string",
              "const": "naked-pair"
            },
            "unit": {
              "$ref": "#/$defs/__schema3"
            },
            "digits": {
              "$ref": "#/$defs/__schema9"
            },
            "cellIds": {
              "$ref": "#/$defs/__schema10"
            }
          },
          "required": [
            "technique",
            "unit",
            "digits",
            "cellIds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "technique": {
              "type": "string",
              "const": "hidden-pair"
            },
            "unit": {
              "$ref": "#/$defs/__schema3"
            },
            "digits": {
              "$ref": "#/$defs/__schema9"
            },
            "cellIds": {
              "$ref": "#/$defs/__schema10"
            }
          },
          "required": [
            "technique",
            "unit",
            "digits",
            "cellIds"
          ],
          "additionalProperties": false
        }
      ]
    },
    "conclusions": {
      "minItems": 1,
      "maxItems": 14,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema11"
      }
    }
  },
  "required": [
    "schemaId",
    "version",
    "proofId",
    "puzzleId",
    "puzzleFingerprint",
    "sourceBoardRevision",
    "sourceBoardFingerprint",
    "rulesetVersion",
    "technique",
    "beforeStateFingerprint",
    "afterStateFingerprint",
    "premises",
    "conclusions"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^r[1-9]c[1-9](?![\\s\\S])"
    },
    "__schema2": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "__schema3": {
      "oneOf": [
        {
          "$ref": "#/$defs/__schema4"
        },
        {
          "$ref": "#/$defs/__schema6"
        },
        {
          "$ref": "#/$defs/__schema7"
        }
      ]
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "row"
        },
        "index": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "kind",
        "index"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "column"
        },
        "index": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "kind",
        "index"
      ],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "box"
        },
        "index": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "kind",
        "index"
      ],
      "additionalProperties": false
    },
    "__schema8": {
      "oneOf": [
        {
          "$ref": "#/$defs/__schema4"
        },
        {
          "$ref": "#/$defs/__schema6"
        }
      ]
    },
    "__schema9": {
      "minItems": 2,
      "maxItems": 2,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    },
    "__schema10": {
      "minItems": 2,
      "maxItems": 2,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "__schema11": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "place"
            },
            "cellId": {
              "$ref": "#/$defs/__schema1"
            },
            "digit": {
              "$ref": "#/$defs/__schema2"
            }
          },
          "required": [
            "kind",
            "cellId",
            "digit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "eliminate"
            },
            "cellId": {
              "$ref": "#/$defs/__schema1"
            },
            "digit": {
              "$ref": "#/$defs/__schema2"
            }
          },
          "required": [
            "kind",
            "cellId",
            "digit"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
