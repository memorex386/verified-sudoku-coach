{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaId": {
      "type": "string",
      "const": "vsc.proof-path"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "proofPathId": {
      "type": "string",
      "pattern": "^path_[0-9a-f]{64}(?![\\s\\S])"
    },
    "puzzleId": {
      "$ref": "#/$defs/__schema0"
    },
    "puzzleFingerprint": {
      "$ref": "#/$defs/__schema1"
    },
    "sourceBoardRevision": {
      "$ref": "#/$defs/__schema2"
    },
    "sourceBoardFingerprint": {
      "$ref": "#/$defs/__schema1"
    },
    "rulesetVersion": {
      "$ref": "#/$defs/__schema3"
    },
    "initialStateFingerprint": {
      "$ref": "#/$defs/__schema1"
    },
    "steps": {
      "maxItems": 810,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      }
    },
    "outcome": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "solved"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "stalled"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "contradiction"
            },
            "code": {
              "type": "string",
              "const": "empty-candidate-set"
            },
            "cellId": {
              "$ref": "#/$defs/__schema5"
            }
          },
          "required": [
            "type",
            "code",
            "cellId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "contradiction"
            },
            "code": {
              "type": "string",
              "const": "duplicate-fixed-value"
            },
            "unit": {
              "$ref": "#/$defs/__schema7"
            },
            "digit": {
              "$ref": "#/$defs/__schema6"
            },
            "cellIds": {
              "minItems": 2,
              "maxItems": 9,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema5"
              }
            }
          },
          "required": [
            "type",
            "code",
            "unit",
            "digit",
            "cellIds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "contradiction"
            },
            "code": {
              "type": "string",
              "const": "no-solution"
            }
          },
          "required": [
            "type",
            "code"
          ],
          "additionalProperties": false
        }
      ]
    },
    "finalStateFingerprint": {
      "$ref": "#/$defs/__schema1"
    }
  },
  "required": [
    "schemaId",
    "version",
    "proofPathId",
    "puzzleId",
    "puzzleFingerprint",
    "sourceBoardRevision",
    "sourceBoardFingerprint",
    "rulesetVersion",
    "initialStateFingerprint",
    "steps",
    "outcome",
    "finalStateFingerprint"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^puz_[a-z0-9]{16,64}(?![\\s\\S])"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "__schema2": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema3": {
      "type": "string",
      "const": "classic-six/v1"
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "schemaId": {
          "type": "string",
          "const": "vsc.proof-step"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "proofId": {
          "type": "string",
          "pattern": "^proof_[0-9a-f]{64}(?![\\s\\S])"
        },
        "puzzleId": {
          "$ref": "#/$defs/__schema0"
        },
        "puzzleFingerprint": {
          "$ref": "#/$defs/__schema1"
        },
        "sourceBoardRevision": {
          "$ref": "#/$defs/__schema2"
        },
        "sourceBoardFingerprint": {
          "$ref": "#/$defs/__schema1"
        },
        "rulesetVersion": {
          "$ref": "#/$defs/__schema3"
        },
        "technique": {
          "type": "string",
          "enum": [
            "naked-single",
            "hidden-single",
            "locked-pointing",
            "locked-claiming",
            "naked-pair",
            "hidden-pair"
          ]
        },
        "beforeStateFingerprint": {
          "$ref": "#/$defs/__schema1"
        },
        "afterStateFingerprint": {
          "$ref": "#/$defs/__schema1"
        },
        "premises": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "technique": {
                  "type": "string",
                  "const": "naked-single"
                },
                "targetCellId": {
                  "$ref": "#/$defs/__schema5"
                },
                "candidateDigits": {
                  "minItems": 1,
                  "maxItems": 1,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema6"
                  }
                }
              },
              "required": [
                "technique",
                "targetCellId",
                "candidateDigits"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "technique": {
                  "type": "string",
                  "const": "hidden-single"
                },
                "unit": {
                  "$ref": "#/$defs/__schema7"
                },
                "digit": {
                  "$ref": "#/$defs/__schema6"
                },
                "candidateCellIds": {
                  "minItems": 1,
                  "maxItems": 1,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema5"
                  }
                }
              },
              "required": [
                "technique",
                "unit",
                "digit",
                "candidateCellIds"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "technique": {
                  "type": "string",
                  "const": "locked-pointing"
                },
                "sourceBox": {
                  "$ref": "#/$defs/__schema11"
                },
                "digit": {
                  "$ref": "#/$defs/__schema6"
                },
                "candidateCellIds": {
                  "minItems": 2,
                  "maxItems": 3,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema5"
                  }
                },
                "confinedTo": {
                  "$ref": "#/$defs/__schema12"
                }
              },
              "required": [
                "technique",
                "sourceBox",
                "digit",
                "candidateCellIds",
                "confinedTo"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "technique": {
                  "type": "string",
                  "const": "locked-claiming"
                },
                "sourceLine": {
                  "$ref": "#/$defs/__schema12"
                },
                "digit": {
                  "$ref": "#/$defs/__schema6"
                },
                "candidateCellIds": {
                  "minItems": 2,
                  "maxItems": 3,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema5"
                  }
                },
                "confinedToBox": {
                  "$ref": "#/$defs/__schema11"
                }
              },
              "required": [
                "technique",
                "sourceLine",
                "digit",
                "candidateCellIds",
                "confinedToBox"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "technique": {
                  "type": "string",
                  "const": "naked-pair"
                },
                "unit": {
                  "$ref": "#/$defs/__schema7"
                },
                "digits": {
                  "$ref": "#/$defs/__schema13"
                },
                "cellIds": {
                  "$ref": "#/$defs/__schema14"
                }
              },
              "required": [
                "technique",
                "unit",
                "digits",
                "cellIds"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "technique": {
                  "type": "string",
                  "const": "hidden-pair"
                },
                "unit": {
                  "$ref": "#/$defs/__schema7"
                },
                "digits": {
                  "$ref": "#/$defs/__schema13"
                },
                "cellIds": {
                  "$ref": "#/$defs/__schema14"
                }
              },
              "required": [
                "technique",
                "unit",
                "digits",
                "cellIds"
              ],
              "additionalProperties": false
            }
          ]
        },
        "conclusions": {
          "minItems": 1,
          "maxItems": 14,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema15"
          }
        }
      },
      "required": [
        "schemaId",
        "version",
        "proofId",
        "puzzleId",
        "puzzleFingerprint",
        "sourceBoardRevision",
        "sourceBoardFingerprint",
        "rulesetVersion",
        "technique",
        "beforeStateFingerprint",
        "afterStateFingerprint",
        "premises",
        "conclusions"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "string",
      "pattern": "^r[1-9]c[1-9](?![\\s\\S])"
    },
    "__schema6": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "__schema7": {
      "oneOf": [
        {
          "$ref": "#/$defs/__schema8"
        },
        {
          "$ref": "#/$defs/__schema10"
        },
        {
          "$ref": "#/$defs/__schema11"
        }
      ]
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "row"
        },
        "index": {
          "$ref": "#/$defs/__schema9"
        }
      },
      "required": [
        "kind",
        "index"
      ],
      "additionalProperties": false
    },
    "__schema9": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "column"
        },
        "index": {
          "$ref": "#/$defs/__schema9"
        }
      },
      "required": [
        "kind",
        "index"
      ],
      "additionalProperties": false
    },
    "__schema11": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "box"
        },
        "index": {
          "$ref": "#/$defs/__schema9"
        }
      },
      "required": [
        "kind",
        "index"
      ],
      "additionalProperties": false
    },
    "__schema12": {
      "oneOf": [
        {
          "$ref": "#/$defs/__schema8"
        },
        {
          "$ref": "#/$defs/__schema10"
        }
      ]
    },
    "__schema13": {
      "minItems": 2,
      "maxItems": 2,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema6"
      }
    },
    "__schema14": {
      "minItems": 2,
      "maxItems": 2,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema5"
      }
    },
    "__schema15": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "place"
            },
            "cellId": {
              "$ref": "#/$defs/__schema5"
            },
            "digit": {
              "$ref": "#/$defs/__schema6"
            }
          },
          "required": [
            "kind",
            "cellId",
            "digit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "eliminate"
            },
            "cellId": {
              "$ref": "#/$defs/__schema5"
            },
            "digit": {
              "$ref": "#/$defs/__schema6"
            }
          },
          "required": [
            "kind",
            "cellId",
            "digit"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
