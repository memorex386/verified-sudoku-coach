{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaId": {
      "type": "string",
      "const": "vsc.trace-envelope"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "traceId": {
      "type": "string",
      "pattern": "^trace_[a-z0-9]{16,64}(?![\\s\\S])"
    },
    "traceRevision": {
      "maximum": 500,
      "$ref": "#/$defs/__schema0"
    },
    "dataClassification": {
      "type": "string",
      "enum": [
        "public-synthetic",
        "private-account-linked"
      ]
    },
    "behaviorIdentity": {
      "type": "object",
      "properties": {
        "schemaId": {
          "type": "string",
          "const": "vsc.behavior-identity"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "rulesetVersion": {
          "$ref": "#/$defs/__schema1"
        },
        "schemaVersion": {
          "$ref": "#/$defs/__schema2"
        },
        "promptVersion": {
          "$ref": "#/$defs/__schema2"
        },
        "modelProfileVersion": {
          "$ref": "#/$defs/__schema2"
        },
        "runtimeRegistrationId": {
          "$ref": "#/$defs/__schema3"
        },
        "runtimeBehaviorVersion": {
          "$ref": "#/$defs/__schema2"
        },
        "rendererVersion": {
          "$ref": "#/$defs/__schema2"
        },
        "fixtureVersion": {
          "$ref": "#/$defs/__schema2"
        },
        "evaluationSuiteVersion": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "schemaId",
        "version",
        "rulesetVersion",
        "schemaVersion",
        "promptVersion",
        "modelProfileVersion",
        "runtimeRegistrationId",
        "runtimeBehaviorVersion",
        "rendererVersion",
        "fixtureVersion",
        "evaluationSuiteVersion"
      ],
      "additionalProperties": false
    },
    "behaviorIdentityHash": {
      "$ref": "#/$defs/__schema4"
    },
    "puzzle": {
      "type": "object",
      "properties": {
        "schemaId": {
          "type": "string",
          "const": "vsc.puzzle-definition"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "puzzleId": {
          "$ref": "#/$defs/__schema5"
        },
        "topology": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "classic"
                },
                "size": {
                  "type": "number",
                  "const": 6
                },
                "boxRows": {
                  "type": "number",
                  "const": 2
                },
                "boxColumns": {
                  "type": "number",
                  "const": 3
                }
              },
              "required": [
                "type",
                "size",
                "boxRows",
                "boxColumns"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "classic"
                },
                "size": {
                  "type": "number",
                  "const": 9
                },
                "boxRows": {
                  "type": "number",
                  "const": 3
                },
                "boxColumns": {
                  "type": "number",
                  "const": 3
                }
              },
              "required": [
                "type",
                "size",
                "boxRows",
                "boxColumns"
              ],
              "additionalProperties": false
            }
          ]
        },
        "givens": {
          "maxItems": 81,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema6"
          }
        },
        "provenance": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "generated"
                },
                "generatorId": {
                  "$ref": "#/$defs/__schema3"
                },
                "generatorVersion": {
                  "$ref": "#/$defs/__schema2"
                },
                "seed": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[\\x20-\\x7e]+(?![\\s\\S])"
                }
              },
              "required": [
                "kind",
                "generatorId",
                "generatorVersion",
                "seed"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "host-catalog"
                },
                "catalogVersion": {
                  "$ref": "#/$defs/__schema2"
                },
                "sourceFingerprint": {
                  "$ref": "#/$defs/__schema4"
                }
              },
              "required": [
                "kind",
                "catalogVersion",
                "sourceFingerprint"
              ],
              "additionalProperties": false
            }
          ]
        },
        "puzzleFingerprint": {
          "$ref": "#/$defs/__schema4"
        }
      },
      "required": [
        "schemaId",
        "version",
        "puzzleId",
        "topology",
        "givens",
        "provenance",
        "puzzleFingerprint"
      ],
      "additionalProperties": false
    },
    "lifecycle": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "open"
            },
            "startedAt": {
              "$ref": "#/$defs/__schema9"
            }
          },
          "required": [
            "state",
            "startedAt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "closed"
            },
            "startedAt": {
              "$ref": "#/$defs/__schema9"
            },
            "closedAt": {
              "$ref": "#/$defs/__schema9"
            },
            "reason": {
              "type": "string",
              "enum": [
                "completed",
                "abandoned",
                "withdrawn",
                "trace-limit",
                "error"
              ]
            }
          },
          "required": [
            "state",
            "startedAt",
            "closedAt",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "events": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema10"
      }
    },
    "traceFingerprint": {
      "$ref": "#/$defs/__schema4"
    }
  },
  "required": [
    "schemaId",
    "version",
    "traceId",
    "traceRevision",
    "dataClassification",
    "behaviorIdentity",
    "behaviorIdentityHash",
    "puzzle",
    "lifecycle",
    "events",
    "traceFingerprint"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema1": {
      "type": "string",
      "const": "classic-six/v1"
    },
    "__schema2": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?![\\s\\S])"
    },
    "__schema3": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?![\\s\\S])"
    },
    "__schema4": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "__schema5": {
      "type": "string",
      "pattern": "^puz_[a-z0-9]{16,64}(?![\\s\\S])"
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "cellId": {
          "$ref": "#/$defs/__schema7"
        },
        "digit": {
          "$ref": "#/$defs/__schema8"
        }
      },
      "required": [
        "cellId",
        "digit"
      ],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "string",
      "pattern": "^r[1-9]c[1-9](?![\\s\\S])"
    },
    "__schema8": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "__schema9": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z(?![\\s\\S])"
    },
    "__schema10": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "eventId": {
              "$ref": "#/$defs/__schema11"
            },
            "sequence": {
              "$ref": "#/$defs/__schema12"
            },
            "recordedAt": {
              "$ref": "#/$defs/__schema9"
            },
            "behaviorIdentityHash": {
              "$ref": "#/$defs/__schema4"
            },
            "type": {
              "type": "string",
              "const": "board-state"
            },
            "payload": {
              "type": "object",
              "properties": {
                "schemaId": {
                  "type": "string",
                  "const": "vsc.board-state"
                },
                "version": {
                  "type": "number",
                  "const": 1
                },
                "puzzleId": {
                  "$ref": "#/$defs/__schema5"
                },
                "puzzleFingerprint": {
                  "$ref": "#/$defs/__schema4"
                },
                "revision": {
                  "$ref": "#/$defs/__schema0"
                },
                "entries": {
                  "maxItems": 81,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema6"
                  }
                },
                "notes": {
                  "maxItems": 81,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema13"
                  }
                },
                "boardFingerprint": {
                  "$ref": "#/$defs/__schema4"
                },
                "stateFingerprint": {
                  "$ref": "#/$defs/__schema4"
                }
              },
              "required": [
                "schemaId",
                "version",
                "puzzleId",
                "puzzleFingerprint",
                "revision",
                "entries",
                "notes",
                "boardFingerprint",
                "stateFingerprint"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "eventId",
            "sequence",
            "recordedAt",
            "behaviorIdentityHash",
            "type",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "eventId": {
              "$ref": "#/$defs/__schema11"
            },
            "sequence": {
              "$ref": "#/$defs/__schema12"
            },
            "recordedAt": {
              "$ref": "#/$defs/__schema9"
            },
            "behaviorIdentityHash": {
              "$ref": "#/$defs/__schema4"
            },
            "type": {
              "type": "string",
              "const": "board-action"
            },
            "payload": {
              "type": "object",
              "properties": {
                "schemaId": {
                  "type": "string",
                  "const": "vsc.board-action"
                },
                "version": {
                  "type": "number",
                  "const": 1
                },
                "commandId": {
                  "type": "string",
                  "pattern": "^cmd_[a-z0-9]{16,64}(?![\\s\\S])"
                },
                "puzzleId": {
                  "$ref": "#/$defs/__schema5"
                },
                "puzzleFingerprint": {
                  "$ref": "#/$defs/__schema4"
                },
                "expectedRevision": {
                  "$ref": "#/$defs/__schema0"
                },
                "expectedStateFingerprint": {
                  "$ref": "#/$defs/__schema4"
                },
                "action": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "place-value"
                        },
                        "cellId": {
                          "$ref": "#/$defs/__schema7"
                        },
                        "digit": {
                          "$ref": "#/$defs/__schema8"
                        }
                      },
                      "required": [
                        "type",
                        "cellId",
                        "digit"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "clear-value"
                        },
                        "cellId": {
                          "$ref": "#/$defs/__schema7"
                        }
                      },
                      "required": [
                        "type",
                        "cellId"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "replace-notes"
                        },
                        "cellId": {
                          "$ref": "#/$defs/__schema7"
                        },
                        "digits": {
                          "maxItems": 9,
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/__schema8"
                          }
                        }
                      },
                      "required": [
                        "type",
                        "cellId",
                        "digits"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "schemaId",
                "version",
                "commandId",
                "puzzleId",
                "puzzleFingerprint",
                "expectedRevision",
                "expectedStateFingerprint",
                "action"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "eventId",
            "sequence",
            "recordedAt",
            "behaviorIdentityHash",
            "type",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "eventId": {
              "$ref": "#/$defs/__schema11"
            },
            "sequence": {
              "$ref": "#/$defs/__schema12"
            },
            "recordedAt": {
              "$ref": "#/$defs/__schema9"
            },
            "behaviorIdentityHash": {
              "$ref": "#/$defs/__schema4"
            },
            "type": {
              "type": "string",
              "const": "proof-step"
            },
            "payload": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "eventId",
            "sequence",
            "recordedAt",
            "behaviorIdentityHash",
            "type",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "eventId": {
              "$ref": "#/$defs/__schema11"
            },
            "sequence": {
              "$ref": "#/$defs/__schema12"
            },
            "recordedAt": {
              "$ref": "#/$defs/__schema9"
            },
            "behaviorIdentityHash": {
              "$ref": "#/$defs/__schema4"
            },
            "type": {
              "type": "string",
              "const": "proof-path"
            },
            "payload": {
              "type": "object",
              "properties": {
                "schemaId": {
                  "type": "string",
                  "const": "vsc.proof-path"
                },
                "version": {
                  "type": "number",
                  "const": 1
                },
                "proofPathId": {
                  "type": "string",
                  "pattern": "^path_[0-9a-f]{64}(?![\\s\\S])"
                },
                "puzzleId": {
                  "$ref": "#/$defs/__schema5"
                },
                "puzzleFingerprint": {
                  "$ref": "#/$defs/__schema4"
                },
                "sourceBoardRevision": {
                  "$ref": "#/$defs/__schema0"
                },
                "sourceBoardFingerprint": {
                  "$ref": "#/$defs/__schema4"
                },
                "rulesetVersion": {
                  "$ref": "#/$defs/__schema1"
                },
                "initialStateFingerprint": {
                  "$ref": "#/$defs/__schema4"
                },
                "steps": {
                  "maxItems": 810,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema14"
                  }
                },
                "outcome": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "solved"
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "stalled"
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "contradiction"
                        },
                        "code": {
                          "type": "string",
                          "const": "empty-candidate-set"
                        },
                        "cellId": {
                          "$ref": "#/$defs/__schema7"
                        }
                      },
                      "required": [
                        "type",
                        "code",
                        "cellId"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "contradiction"
                        },
                        "code": {
                          "type": "string",
                          "const": "duplicate-fixed-value"
                        },
                        "unit": {
                          "$ref": "#/$defs/__schema15"
                        },
                        "digit": {
                          "$ref": "#/$defs/__schema8"
                        },
                        "cellIds": {
                          "minItems": 2,
                          "maxItems": 9,
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/__schema7"
                          }
                        }
                      },
                      "required": [
                        "type",
                        "code",
                        "unit",
                        "digit",
                        "cellIds"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "contradiction"
                        },
                        "code": {
                          "type": "string",
                          "const": "no-solution"
                        }
                      },
                      "required": [
                        "type",
                        "code"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "finalStateFingerprint": {
                  "$ref": "#/$defs/__schema4"
                }
              },
              "required": [
                "schemaId",
                "version",
                "proofPathId",
                "puzzleId",
                "puzzleFingerprint",
                "sourceBoardRevision",
                "sourceBoardFingerprint",
                "rulesetVersion",
                "initialStateFingerprint",
                "steps",
                "outcome",
                "finalStateFingerprint"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "eventId",
            "sequence",
            "recordedAt",
            "behaviorIdentityHash",
            "type",
            "payload"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema11": {
      "type": "string",
      "pattern": "^evt_[a-z0-9]{16,64}(?![\\s\\S])"
    },
    "__schema12": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "__schema13": {
      "type": "object",
      "properties": {
        "cellId": {
          "$ref": "#/$defs/__schema7"
        },
        "digits": {
          "minItems": 1,
          "maxItems": 9,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema8"
          }
        }
      },
      "required": [
        "cellId",
        "digits"
      ],
      "additionalProperties": false
    },
    "__schema14": {
      "type": "object",
      "properties": {
        "schemaId": {
          "type": "string",
          "const": "vsc.proof-step"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "proofId": {
          "type": "string",
          "pattern": "^proof_[0-9a-f]{64}(?![\\s\\S])"
        },
        "puzzleId": {
          "$ref": "#/$defs/__schema5"
        },
        "puzzleFingerprint": {
          "$ref": "#/$defs/__schema4"
        },
        "sourceBoardRevision": {
          "$ref": "#/$defs/__schema0"
        },
        "sourceBoardFingerprint": {
          "$ref": "#/$defs/__schema4"
        },
        "rulesetVersion": {
          "$ref": "#/$defs/__schema1"
        },
        "technique": {
          "type": "string",
          "enum": [
            "naked-single",
            "hidden-single",
            "locked-pointing",
            "locked-claiming",
            "naked-pair",
            "hidden-pair"
          ]
        },
        "beforeStateFingerprint": {
          "$ref": "#/$defs/__schema4"
        },
        "afterStateFingerprint": {
          "$ref": "#/$defs/__schema4"
        },
        "premises": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "technique": {
                  "type": "string",
                  "const": "naked-single"
                },
                "targetCellId": {
                  "$ref": "#/$defs/__schema7"
                },
                "candidateDigits": {
                  "minItems": 1,
                  "maxItems": 1,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema8"
                  }
                }
              },
              "required": [
                "technique",
                "targetCellId",
                "candidateDigits"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "technique": {
                  "type": "string",
                  "const": "hidden-single"
                },
                "unit": {
                  "$ref": "#/$defs/__schema15"
                },
                "digit": {
                  "$ref": "#/$defs/__schema8"
                },
                "candidateCellIds": {
                  "minItems": 1,
                  "maxItems": 1,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema7"
                  }
                }
              },
              "required": [
                "technique",
                "unit",
                "digit",
                "candidateCellIds"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "technique": {
                  "type": "string",
                  "const": "locked-pointing"
                },
                "sourceBox": {
                  "$ref": "#/$defs/__schema19"
                },
                "digit": {
                  "$ref": "#/$defs/__schema8"
                },
                "candidateCellIds": {
                  "minItems": 2,
                  "maxItems": 3,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema7"
                  }
                },
                "confinedTo": {
                  "$ref": "#/$defs/__schema20"
                }
              },
              "required": [
                "technique",
                "sourceBox",
                "digit",
                "candidateCellIds",
                "confinedTo"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "technique": {
                  "type": "string",
                  "const": "locked-claiming"
                },
                "sourceLine": {
                  "$ref": "#/$defs/__schema20"
                },
                "digit": {
                  "$ref": "#/$defs/__schema8"
                },
                "candidateCellIds": {
