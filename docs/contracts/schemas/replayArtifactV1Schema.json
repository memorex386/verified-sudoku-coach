{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaId": {
      "type": "string",
      "const": "vsc.replay-artifact"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "replayId": {
      "type": "string",
      "pattern": "^replay_[a-z0-9]{16,64}(?![\\s\\S])"
    },
    "dataClassification": {
      "type": "string",
      "const": "public-synthetic"
    },
    "behaviorIdentity": {
      "type": "object",
      "properties": {
        "schemaId": {
          "type": "string",
          "const": "vsc.behavior-identity"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "rulesetVersion": {
          "$ref": "#/$defs/__schema0"
        },
        "schemaVersion": {
          "$ref": "#/$defs/__schema1"
        },
        "promptVersion": {
          "$ref": "#/$defs/__schema1"
        },
        "modelProfileVersion": {
          "$ref": "#/$defs/__schema1"
        },
        "runtimeRegistrationId": {
          "$ref": "#/$defs/__schema2"
        },
        "runtimeBehaviorVersion": {
          "$ref": "#/$defs/__schema1"
        },
        "rendererVersion": {
          "$ref": "#/$defs/__schema1"
        },
        "fixtureVersion": {
          "$ref": "#/$defs/__schema1"
        },
        "evaluationSuiteVersion": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "schemaId",
        "version",
        "rulesetVersion",
        "schemaVersion",
        "promptVersion",
        "modelProfileVersion",
        "runtimeRegistrationId",
        "runtimeBehaviorVersion",
        "rendererVersion",
        "fixtureVersion",
        "evaluationSuiteVersion"
      ],
      "additionalProperties": false
    },
    "behaviorIdentityHash": {
      "$ref": "#/$defs/__schema3"
    },
    "puzzle": {
      "type": "object",
      "properties": {
        "schemaId": {
          "type": "string",
          "const": "vsc.puzzle-definition"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "puzzleId": {
          "$ref": "#/$defs/__schema4"
        },
        "topology": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "classic"
                },
                "size": {
                  "type": "number",
                  "const": 6
                },
                "boxRows": {
                  "type": "number",
                  "const": 2
                },
                "boxColumns": {
                  "type": "number",
                  "const": 3
                }
              },
              "required": [
                "type",
                "size",
                "boxRows",
                "boxColumns"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "classic"
                },
                "size": {
                  "type": "number",
                  "const": 9
                },
                "boxRows": {
                  "type": "number",
                  "const": 3
                },
                "boxColumns": {
                  "type": "number",
                  "const": 3
                }
              },
              "required": [
                "type",
                "size",
                "boxRows",
                "boxColumns"
              ],
              "additionalProperties": false
            }
          ]
        },
        "givens": {
          "maxItems": 81,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema5"
          }
        },
        "provenance": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "generated"
                },
                "generatorId": {
                  "$ref": "#/$defs/__schema2"
                },
                "generatorVersion": {
                  "$ref": "#/$defs/__schema1"
                },
                "seed": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[\\x20-\\x7e]+(?![\\s\\S])"
                }
              },
              "required": [
                "kind",
                "generatorId",
                "generatorVersion",
                "seed"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "host-catalog"
                },
                "catalogVersion": {
                  "$ref": "#/$defs/__schema1"
                },
                "sourceFingerprint": {
                  "$ref": "#/$defs/__schema3"
                }
              },
              "required": [
                "kind",
                "catalogVersion",
                "sourceFingerprint"
              ],
              "additionalProperties": false
            }
          ]
        },
        "puzzleFingerprint": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "schemaId",
        "version",
        "puzzleId",
        "topology",
        "givens",
        "provenance",
        "puzzleFingerprint"
      ],
      "additionalProperties": false
    },
    "initialBoard": {
      "$ref": "#/$defs/__schema8"
    },
    "records": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema11"
      }
    },
    "replayFingerprint": {
      "$ref": "#/$defs/__schema3"
    }
  },
  "required": [
    "schemaId",
    "version",
    "replayId",
    "dataClassification",
    "behaviorIdentity",
    "behaviorIdentityHash",
    "puzzle",
    "initialBoard",
    "records",
    "replayFingerprint"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "classic-six/v1"
    },
    "__schema1": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?![\\s\\S])"
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?![\\s\\S])"
    },
    "__schema3": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "__schema4": {
      "type": "string",
      "pattern": "^puz_[a-z0-9]{16,64}(?![\\s\\S])"
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "cellId": {
          "$ref": "#/$defs/__schema6"
        },
        "digit": {
          "$ref": "#/$defs/__schema7"
        }
      },
      "required": [
        "cellId",
        "digit"
      ],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "string",
      "pattern": "^r[1-9]c[1-9](?![\\s\\S])"
    },
    "__schema7": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "schemaId": {
          "type": "string",
          "const": "vsc.board-state"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "puzzleId": {
          "$ref": "#/$defs/__schema4"
        },
        "puzzleFingerprint": {
          "$ref": "#/$defs/__schema3"
        },
        "revision": {
          "$ref": "#/$defs/__schema9"
        },
        "entries": {
          "maxItems": 81,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema5"
          }
        },
        "notes": {
          "maxItems": 81,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema10"
          }
        },
        "boardFingerprint": {
          "$ref": "#/$defs/__schema3"
        },
        "stateFingerprint": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "schemaId",
        "version",
        "puzzleId",
        "puzzleFingerprint",
        "revision",
        "entries",
        "notes",
        "boardFingerprint",
        "stateFingerprint"
      ],
      "additionalProperties": false
    },
    "__schema9": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "cellId": {
          "$ref": "#/$defs/__schema6"
        },
        "digits": {
          "minItems": 1,
          "maxItems": 9,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema7"
          }
        }
      },
      "required": [
        "cellId",
        "digits"
      ],
      "additionalProperties": false
    },
    "__schema11": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "action": {
          "type": "object",
          "properties": {
            "schemaId": {
              "type": "string",
              "const": "vsc.board-action"
            },
            "version": {
              "type": "number",
              "const": 1
            },
            "commandId": {
              "type": "string",
              "pattern": "^cmd_[a-z0-9]{16,64}(?![\\s\\S])"
            },
            "puzzleId": {
              "$ref": "#/$defs/__schema4"
            },
            "puzzleFingerprint": {
              "$ref": "#/$defs/__schema3"
            },
            "expectedRevision": {
              "$ref": "#/$defs/__schema9"
            },
            "expectedStateFingerprint": {
              "$ref": "#/$defs/__schema3"
            },
            "action": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "place-value"
                    },
                    "cellId": {
                      "$ref": "#/$defs/__schema6"
                    },
                    "digit": {
                      "$ref": "#/$defs/__schema7"
                    }
                  },
                  "required": [
                    "type",
                    "cellId",
                    "digit"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "clear-value"
                    },
                    "cellId": {
                      "$ref": "#/$defs/__schema6"
                    }
                  },
                  "required": [
                    "type",
                    "cellId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "replace-notes"
                    },
                    "cellId": {
                      "$ref": "#/$defs/__schema6"
                    },
                    "digits": {
                      "maxItems": 9,
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/__schema7"
                      }
                    }
                  },
                  "required": [
                    "type",
                    "cellId",
                    "digits"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "schemaId",
            "version",
            "commandId",
            "puzzleId",
            "puzzleFingerprint",
            "expectedRevision",
            "expectedStateFingerprint",
            "action"
          ],
          "additionalProperties": false
        },
        "result": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "accepted"
                },
                "board": {
                  "$ref": "#/$defs/__schema8"
                },
                "proofPath": {
                  "type": "object",
                  "properties": {
                    "schemaId": {
                      "type": "string",
                      "const": "vsc.proof-path"
                    },
                    "version": {
                      "type": "number",
                      "const": 1
                    },
                    "proofPathId": {
                      "type": "string",
                      "pattern": "^path_[0-9a-f]{64}(?![\\s\\S])"
                    },
                    "puzzleId": {
                      "$ref": "#/$defs/__schema4"
                    },
                    "puzzleFingerprint": {
                      "$ref": "#/$defs/__schema3"
                    },
                    "sourceBoardRevision": {
                      "$ref": "#/$defs/__schema9"
                    },
                    "sourceBoardFingerprint": {
                      "$ref": "#/$defs/__schema3"
                    },
                    "rulesetVersion": {
                      "$ref": "#/$defs/__schema0"
                    },
                    "initialStateFingerprint": {
                      "$ref": "#/$defs/__schema3"
                    },
                    "steps": {
                      "maxItems": 810,
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/__schema12"
                      }
                    },
                    "outcome": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "solved"
                            }
                          },
                          "required": [
                            "type"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "stalled"
                            }
                          },
                          "required": [
                            "type"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "contradiction"
                            },
                            "code": {
                              "type": "string",
                              "const": "empty-candidate-set"
                            },
                            "cellId": {
                              "$ref": "#/$defs/__schema6"
                            }
                          },
                          "required": [
                            "type",
                            "code",
                            "cellId"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "contradiction"
                            },
                            "code": {
                              "type": "string",
                              "const": "duplicate-fixed-value"
                            },
                            "unit": {
                              "$ref": "#/$defs/__schema13"
                            },
                            "digit": {
                              "$ref": "#/$defs/__schema7"
                            },
                            "cellIds": {
                              "minItems": 2,
                              "maxItems": 9,
                              "type": "array",
                              "items": {
                                "$ref": "#/$defs/__schema6"
                              }
                            }
                          },
                          "required": [
                            "type",
                            "code",
                            "unit",
                            "digit",
                            "cellIds"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "contradiction"
                            },
                            "code": {
                              "type": "string",
                              "const": "no-solution"
                            }
                          },
                          "required": [
                            "type",
                            "code"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "finalStateFingerprint": {
                      "$ref": "#/$defs/__schema3"
                    }
                  },
                  "required": [
                    "schemaId",
                    "version",
                    "proofPathId",
                    "puzzleId",
                    "puzzleFingerprint",
                    "sourceBoardRevision",
                    "sourceBoardFingerprint",
                    "rulesetVersion",
                    "initialStateFingerprint",
                    "steps",
                    "outcome",
                    "finalStateFingerprint"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "type",
                "board",
                "proofPath"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "rejected"
                },
                "code": {
                  "type": "string",
                  "enum": [
                    "stale",
                    "invalid-action"
                  ]
                },
                "stateFingerprint": {
                  "$ref": "#/$defs/__schema3"
                }
              },
              "required": [
                "type",
                "code",
                "stateFingerprint"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "sequence",
        "action",
        "result"
      ],
      "additionalProperties": false
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "schemaId": {
          "type": "string",
          "const": "vsc.proof-step"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "proofId": {
          "type": "string",
          "pattern": "^proof_[0-9a-f]{64}(?![\\s\\S])"
        },
        "puzzleId": {
          "$ref": "#/$defs/__schema4"
        },
        "puzzleFingerprint": {
          "$ref": "#/$defs/__schema3"
        },
        "sourceBoardRevision": {
          "$ref": "#/$defs/__schema9"
        },
        "sourceBoardFingerprint": {
          "$ref": "#/$defs/__schema3"
        },
        "rulesetVersion": {
          "$ref": "#/$defs/__schema0"
        },
        "technique": {
          "type": "string",
          "enum": [
            "naked-single",
            "hidden-single",
            "locked-pointing",
            "locked-claiming",
            "naked-pair",
            "hidden-pair"
          ]
        },
        "beforeStateFingerprint": {
          "$ref": "#/$defs/__schema3"
        },
        "afterStateFingerprint": {
          "$ref": "#/$defs/__schema3"
        },
        "premises": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "technique": {
                  "type": "string",
                  "const": "naked-single"
                },
                "targetCellId": {
                  "$ref": "#/$defs/__schema6"
                },
                "candidateDigits": {
                  "minItems": 1,
                  "maxItems": 1,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema7"
                  }
                }
              },
              "required": [
                "technique",
                "targetCellId",
                "candidateDigits"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "technique": {
                  "type": "string",
                  "const": "hidden-single"
                },
                "unit": {
                  "$ref": "#/$defs/__schema13"
                },
                "digit": {
                  "$ref": "#/$defs/__schema7"
                },
                "candidateCellIds": {
                  "minItems": 1,
                  "maxItems": 1,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema6"
                  }
                }
              },
              "required": [
                "technique",
                "unit",
                "digit",
                "candidateCellIds"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "technique": {
                  "type": "string",
                  "const": "locked-pointing"
                },
                "sourceBox": {
                  "$ref": "#/$defs/__schema17"
                },
                "digit": {
                  "$ref": "#/$defs/__schema7"
                },
                "candidateCellIds": {
                  "minItems": 2,
                  "maxItems": 3,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema6"
                  }
                },
                "confinedTo": {
                  "$ref": "#/$defs/__schema18"
                }
              },
              "required": [
                "technique",
                "sourceBox",
                "digit",
                "candidateCellIds",
                "confinedTo"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "technique": {
                  "type": "string",
                  "const": "locked-claiming"
                },
                "sourceLine": {
                  "$ref": "#/$defs/__schema18"
                },
                "digit": {
                  "$ref": "#/$defs/__schema7"
                },
                "candidateCellIds": {
                  "minItems": 2,
                  "maxItems": 3,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema6"
                  }
                },
                "confinedToBox": {
                  "$ref": "#/$defs/__schema17"
                }
              },
              "required": [
                "technique",
                "sourceLine",
                "digit",
                "candidateCellIds",
                "confinedToBox"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "technique": {
                  "type": "string",
                  "const": "naked-pair"
                },
                "unit": {
                  "$ref": "#/$defs/__schema13"
                },
                "digits": {
                  "$ref": "#/$defs/__schema19"
                },
                "cellIds": {
                  "$ref": "#/$defs/__schema20"
                }
              },
              "required": [
                "technique",
                "unit",
                "digits",
                "cellIds"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "technique": {
                  "type": "string",
                  "const": "hidden-pair"
                },
                "unit": {
                  "$ref": "#/$defs/__schema13"
                },
                "digits": {
                  "$ref": "#/$defs/__schema19"
                },
                "cellIds": {
                  "$ref": "#/$defs/__schema20"
                }
              },
              "required": [
                "technique",
                "unit",
                "digits",
                "cellIds"
              ],
              "additionalProperties": false
            }
          ]
        },
        "conclusions": {
          "minItems": 1,
          "maxItems": 14,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema21"
          }
        }
      },
      "required": [
        "schemaId",
        "version",
        "proofId",
        "puzzleId",
        "puzzleFingerprint",
        "sourceBoardRevision",
        "sourceBoardFingerprint",
        "rulesetVersion",
        "technique",
        "beforeStateFingerprint",
        "afterStateFingerprint",
        "premises",
        "conclusions"
      ],
      "additionalProperties": false
    },
    "__schema13": {
      "oneOf": [
        {
          "$ref": "#/$defs/__schema14"
        },
        {
          "$ref": "#/$defs/__schema16"
        },
        {
          "$ref": "#/$defs/__schema17"
        }
      ]
    },
    "__schema14": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "row"
        },
        "index": {
          "$ref": "#/$defs/__schema15"
        }
      },
      "required": [
        "kind",
        "index"
      ],
      "additionalProperties": false
    },
    "__schema15": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "__schema16": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "column"
        },
        "index": {
          "$ref": "#/$defs/__schema15"
        }
      },
      "required": [
        "kind",
        "index"
      ],
